---
import Layout from '../layouts/Layout.astro';

const branchesData = [
  {
    id: "chatukupadu",
    name: "Chatukupadu",
    churchName: "Bride of Lord Jesus Christ Tabernacle",
    address: "Chatukupadu, Jarugumalli Mandal, Prakasam District, Andhra Pradesh — 523001",
    sundayWorship: "Sunday · 10:00 AM",
    otherServices: [
      "Prayer & Intercession: Saturday · 8:00 PM",
      "Fasting Meeting: 1st Friday · 8:00 PM",
      "Lord's Supper: 1st Sunday · 4:00 PM"
    ],
    leaderRole: "Pastor",
    leaderName: "Pastor Rufus Daniel",
    mapQuery: "Chatukupadu, Jarugumalli Mandal, Prakasam District, Andhra Pradesh 523001"
  },
  {
    id: "kandukur",
    name: "Kandukur",
    churchName: "Bride of Christ Tabernacle",
    address: "Near Pattu, Kovvuru Road, Kandukur, Andhra Pradesh",
    sundayWorship: "Sunday · 9:00 AM",
    otherServices: [],
    leaderRole: "Pastor",
    leaderName: "Pastor Rufus Daniel",
    mapQuery: "Near Pattu, Kovvuru Road, Kandukur, Andhra Pradesh"
  },
  {
    id: "ongole",
    name: "Ongole",
    churchName: "Bride of Christ Tabernacle",
    address: "Rajapanagal 15th Cross Road, Gaddalagunta, Ongole, Prakasam District, Andhra Pradesh — 523001",
    sundayWorship: "Sunday · 7:00 PM",
    otherServices: [
      "Bible Study: Wednesday · 7:00 PM"
    ],
    leaderRole: "Pastor",
    leaderName: "Pastor Rufus Daniel",
    mapQuery: "Rajapanagal 15th Cross Road, Gaddalagunta, Ongole, Prakasam District, Andhra Pradesh 523001"
  },
  {
    id: "vempadu",
    name: "Vempadu",
    churchName: "End Time Message Church",
    address: "Vempadu Village, Ponnaluru Mandal, Prakasam District, Andhra Pradesh",
    sundayWorship: "Sunday · 10:00 AM",
    otherServices: [],
    leaderRole: "Minister",
    leaderName: "Brother Prem Sagar",
    mapQuery: "Vempadu Village, Ponnaluru Mandal, Prakasam District, Andhra Pradesh"
  }
];
---

<Layout title="Contact Us">
  <!-- Hero Banner -->
  <section class="relative py-14 md:py-18 bg-gradient-to-r from-[#8B0000] via-[#700000] to-[#4a0000] text-white text-center overflow-hidden">
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 36px 36px;"></div>

    <div class="max-w-3xl mx-auto px-6 relative z-10">
      <p class="text-[#e07b20] text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase mb-2 opacity-90">
        We'd Love to Connect
      </p>
      <h1 class="font-outfit text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-3">Contact Us</h1>
      <div class="w-12 h-px bg-white/30 mx-auto my-3"></div>
      <p class="text-white/80 text-sm sm:text-base max-w-lg mx-auto font-light leading-relaxed">
        Reach out with questions, prayer requests, or to plan your visit to any of our church branches.
      </p>
    </div>
  </section>

  <!-- Contact & Branch Locator -->
  <section class="py-14 md:py-20 bg-[#fafafa] flex-grow">
    <div class="max-w-6xl mx-auto px-6 sm:px-8 space-y-12">
      
      <!-- Top Section: Central Ministry Outreach Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Card 1: Phone / Direct Pastoral Line -->
        <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 border-t-4 border-t-[#8B0000] shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-xl bg-[#8B0000]/8 flex items-center justify-center text-[#8B0000] mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h3 class="font-outfit text-lg font-bold text-gray-900 mb-1">Call / WhatsApp</h3>
            <p class="text-xs text-gray-500 mb-3">Pastor Rufus Daniel</p>
            <p class="text-xl font-extrabold text-gray-900 tracking-tight mb-4">9866 866 856</p>
          </div>
          <a
            href="tel:9866866856"
            class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-[#8B0000] text-white text-xs sm:text-sm font-semibold hover:bg-[#700000] transition-colors duration-200 shadow-2xs"
          >
            <span>Call Now</span>
          </a>
        </div>

        <!-- Card 2: Email Ministry -->
        <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 border-t-4 border-t-[#8B0000] shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-xl bg-[#8B0000]/8 flex items-center justify-center text-[#8B0000] mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="font-outfit text-lg font-bold text-gray-900 mb-1">Email Us</h3>
            <p class="text-xs text-gray-500 mb-3">Questions &amp; Inquiries</p>
            <p class="text-base font-extrabold text-gray-900 tracking-tight mb-4 break-all">danmonu@gmail.com</p>
          </div>
          <a
            href="mailto:danmonu@gmail.com"
            class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-[#8B0000] text-white text-xs sm:text-sm font-semibold hover:bg-[#700000] transition-colors duration-200 shadow-2xs"
          >
            <span>Send Email</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        </div>

        <!-- Card 3: YouTube Ministry -->
        <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 border-t-4 border-t-[#8B0000] shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-xl bg-[#8B0000]/8 flex items-center justify-center text-[#8B0000] mb-4">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.501 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.377.55 9.377.55s7.505 0 9.377-.55a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </div>
            <h3 class="font-outfit text-lg font-bold text-gray-900 mb-1">YouTube Channel</h3>
            <p class="text-xs text-gray-500 mb-3">Watch Messages & Live Streams</p>
            <p class="text-base font-bold text-gray-800 mb-4">Pastor Rufus Daniel</p>
          </div>
          <a
            href="https://www.youtube.com/channel/UC2uIzBRoPgTt0t73R7N_y6Q"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-[#8B0000] text-white text-xs sm:text-sm font-semibold hover:bg-[#700000] transition-colors duration-200 shadow-2xs"
          >
            <span>Watch Online</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
        </div>

        <!-- Card 4: Prayer Requests & Fellowship -->
        <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 border-t-4 border-t-[#8B0000] shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-xl bg-[#8B0000]/8 flex items-center justify-center text-[#8B0000] mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="font-outfit text-lg font-bold text-gray-900 mb-1">Prayer &amp; Fellowship</h3>
            <p class="text-xs text-gray-500 mb-3">Join Us in Worship</p>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">
              Join any of our 4 branch services or request pastoral prayer.
            </p>
          </div>
          <a
            href="/branches"
            class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-[#8B0000] text-white text-xs sm:text-sm font-semibold hover:bg-[#700000] transition-colors duration-200 shadow-2xs"
          >
            <span>View Schedules →</span>
          </a>
        </div>

      </div>

      <!-- Bottom Section: Interactive Branch Selector & Map -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 md:p-10">
        
        <!-- Header -->
        <div class="text-center sm:text-left mb-8 pb-6 border-b border-gray-100 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <p class="text-[#8B0000] font-bold tracking-[0.15em] uppercase text-xs mb-1">Branch Locations</p>
            <h2 class="font-outfit text-2xl sm:text-3xl font-extrabold text-gray-900">Find Your Nearest Branch</h2>
            <p class="text-gray-500 text-sm mt-1">Select a branch below to view its address, leadership, and location map.</p>
          </div>
          
          <a href="/branches" class="text-xs font-bold text-[#8B0000] hover:underline self-start sm:self-auto inline-flex items-center gap-1">
            Full Branch Directory &rarr;
          </a>
        </div>

        <!-- Branch Selector Tabs -->
        <div class="flex flex-wrap gap-2.5 mb-8" role="tablist" aria-label="Branch tabs">
          {branchesData.map((b, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls={`panel-${b.id}`}
              id={`tab-${b.id}`}
              data-branch-id={b.id}
              class={`branch-tab px-5 py-2.5 rounded-xl font-outfit text-sm font-bold transition-all duration-200 cursor-pointer ${
                idx === 0 
                  ? 'bg-[#8B0000] text-white shadow-xs' 
                  : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
              }`}
            >
              {b.name}
            </button>
          ))}
        </div>

        <!-- Branch Panels & Map Area -->
        {branchesData.map((b, idx) => {
          const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(b.mapQuery)}`;
          const embedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(b.mapQuery)}&t=&z=14&ie=UTF8&iwloc=&output=embed`;

          return (
            <div
              id={`panel-${b.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${b.id}`}
              class={`branch-panel ${idx === 0 ? 'grid' : 'hidden'} grid-cols-1 lg:grid-cols-12 gap-8 items-stretch`}
            >
              <!-- Info Box (5 cols) -->
              <div class="lg:col-span-5 flex flex-col justify-between p-6 rounded-2xl bg-gray-50/80 border border-gray-100">
                <div class="space-y-4 text-sm">
                  
                  <div>
                    <h3 class="font-outfit text-2xl font-bold text-gray-900">{b.name}</h3>
                    <p class="text-xs font-semibold text-[#8B0000] mt-0.5">{b.churchName}</p>
                  </div>

                  <!-- Address -->
                  <div class="flex items-start gap-2.5 text-gray-700 pt-2 border-t border-gray-200/60">
                    <svg class="w-4 h-4 text-[#8B0000] mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <p class="leading-relaxed">{b.address}</p>
                  </div>

                  <!-- Worship Timing -->
                  <div class="flex items-start gap-2.5 text-gray-700">
                    <svg class="w-4 h-4 text-[#8B0000] mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"></path>
                    </svg>
                    <div>
                      <p class="font-bold text-gray-900 text-xs uppercase tracking-wider">Sunday Worship</p>
                      <p class="font-semibold text-[#8B0000]">{b.sundayWorship}</p>
                    </div>
                  </div>

                  <!-- Leader -->
                  <div class="pt-2 border-t border-gray-200/60 text-xs text-gray-600 flex items-center gap-2">
                    <span class="font-bold uppercase text-gray-500">{b.leaderRole}:</span>
                    <span class="font-semibold text-gray-900 text-sm">{b.leaderName}</span>
                  </div>

                </div>

                <!-- Directions Link -->
                <div class="pt-5 mt-4 border-t border-gray-200/60">
                  <a
                    href={directionsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-[#8B0000] text-white text-xs sm:text-sm font-semibold hover:bg-[#700000] transition-colors duration-200 shadow-2xs"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>Open in Google Maps</span>
                    <svg class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  </a>
                </div>
              </div>

              <!-- Embedded Google Map (7 cols) -->
              <div class="lg:col-span-7 bg-gray-100 rounded-2xl overflow-hidden border border-gray-200 min-h-[320px] lg:min-h-[380px] relative shadow-2xs">
                <iframe
                  title={`Map of ${b.name} branch`}
                  class="w-full h-full min-h-[320px] lg:min-h-[380px] border-0"
                  src={embedUrl}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          );
        })}

      </div>

    </div>
  </section>
</Layout>

<script>
  function setupBranchTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.branch-tab');
    const panels = document.querySelectorAll<HTMLElement>('.branch-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const branchId = tab.dataset.branchId;

        // Update tabs active state
        tabs.forEach((t) => {
          t.setAttribute('aria-selected', 'false');
          t.className = 'branch-tab px-5 py-2.5 rounded-xl font-outfit text-sm font-bold transition-all duration-200 cursor-pointer bg-gray-100 text-gray-700 hover:bg-gray-200';
        });

        tab.setAttribute('aria-selected', 'true');
        tab.className = 'branch-tab px-5 py-2.5 rounded-xl font-outfit text-sm font-bold transition-all duration-200 cursor-pointer bg-[#8B0000] text-white shadow-xs';

        // Show active panel
        panels.forEach((panel) => {
          if (panel.id === `panel-${branchId}`) {
            panel.classList.remove('hidden');
            panel.classList.add('grid');
          } else {
            panel.classList.add('hidden');
            panel.classList.remove('grid');
          }
        });
      });
    });
  }

  // Run on initial load and on view transitions
  setupBranchTabs();
  document.addEventListener('astro:page-load', setupBranchTabs);
</script>
