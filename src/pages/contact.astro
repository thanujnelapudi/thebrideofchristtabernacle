---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us">
  <!-- Hero Banner -->
  <section class="relative py-20 md:py-24 bg-gradient-to-r from-[#8B0000] via-[#700000] to-[#4a0000] text-white text-center overflow-hidden">
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 36px 36px;"></div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <p class="text-[#e07b20] text-sm font-semibold tracking-[0.2em] uppercase mb-3 opacity-90">
        We'd Love to Connect
      </p>
      <h1 class="font-outfit text-4xl sm:text-5xl md:text-6xl font-extrabold text-white mb-4">Contact Us</h1>
      <div class="w-16 h-px bg-white/30 mx-auto mt-4 mb-4"></div>
      <p class="text-white/80 text-base sm:text-lg max-w-xl mx-auto font-light leading-relaxed">
        Reach out to us with any questions, prayer requests, or to plan your first visit.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-20 md:py-28 bg-[#fafafa] flex-grow">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        
        <!-- Info Column -->
        <div class="p-8 md:p-12">
          <p class="text-[#8B0000] font-bold tracking-[0.15em] uppercase text-xs sm:text-sm mb-2">Reach Out</p>
          <h2 class="font-outfit text-3xl font-extrabold text-gray-900 mb-8">Get in Touch</h2>
          
          <div class="space-y-8">
            <div class="flex items-start">
              <div class="flex-shrink-0 bg-[#8B0000]/8 p-3.5 rounded-xl text-[#8B0000]">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-bold text-gray-900">Address</h3>
                <p class="mt-1 text-gray-600 font-light"><!-- REPLACE: Address -->123 Church Street<br/>City, State, ZIP Code</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="flex-shrink-0 bg-[#8B0000]/8 p-3.5 rounded-xl text-[#8B0000]">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-bold text-gray-900">Phone</h3>
                <a href="tel:+15551234567" class="mt-1 text-gray-600 hover:text-[#8B0000] font-light block transition-colors"><!-- REPLACE: Phone -->+1 (555) 123-4567</a>
              </div>
            </div>

            <div class="flex items-start">
              <div class="flex-shrink-0 bg-[#8B0000]/8 p-3.5 rounded-xl text-[#8B0000]">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-bold text-gray-900">Email</h3>
                <a href="mailto:info@brideofchristtabernacle.com" class="mt-1 text-gray-600 hover:text-[#8B0000] font-light block transition-colors"><!-- REPLACE: Email -->info@brideofchristtabernacle.com</a>
              </div>
            </div>
          </div>

          <div class="mt-12 pt-8 border-t border-gray-100">
             <h3 class="text-sm font-bold tracking-[0.12em] uppercase text-gray-800 mb-4">Follow Us</h3>
             <div class="flex space-x-3">
                <a href="#" class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 hover:bg-[#8B0000] hover:text-white transition-all duration-200" aria-label="YouTube">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.501 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.377.55 9.377.55s7.505 0 9.377-.55a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                </a>
                <a href="#" class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 hover:bg-[#8B0000] hover:text-white transition-all duration-200" aria-label="Facebook">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
                </a>
                <a href="#" class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 hover:bg-[#8B0000] hover:text-white transition-all duration-200" aria-label="Instagram">
                   <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.203 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                </a>
             </div>
          </div>
        </div>

        <!-- Map Column -->
        <div class="bg-gray-100 flex items-center justify-center min-h-[400px] lg:min-h-full relative">
           <p class="text-gray-500 font-medium absolute z-10 text-center px-4">
              <!-- REPLACE: Google Maps embed src -->
              Map coming soon
           </p>
           <iframe class="absolute inset-0 w-full h-full opacity-0 hover:opacity-100 transition-opacity z-20" src="" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        
      </div>
    </div>
  </section>
</Layout>
