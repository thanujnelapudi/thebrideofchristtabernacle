---
import Layout from '../layouts/Layout.astro';
import BranchCard from '../components/BranchCard.astro';

const branches = [
  { branchName: "Main Branch", city: "City Name Placeholder", address: "123 Placeholder St, District", serviceTime: "Sunday, 10:00 AM" },
  { branchName: "North Branch", city: "City Name Placeholder", address: "456 North Ave, District", serviceTime: "Sunday, 9:00 AM" },
  { branchName: "South Branch", city: "City Name Placeholder", address: "789 South Blvd, District", serviceTime: "Sunday, 11:00 AM" },
  { branchName: "East Branch", city: "City Name Placeholder", address: "101 East Rd, District", serviceTime: "Sunday, 10:30 AM" },
  { branchName: "West Branch", city: "City Name Placeholder", address: "202 West Ln, District", serviceTime: "Sunday, 8:30 AM" },
  { branchName: "Central Branch", city: "City Name Placeholder", address: "303 Central Sq, District", serviceTime: "Sunday, 9:30 AM" },
];
---

<Layout title="Our Branches">
  <!-- Hero Banner -->
  <section class="relative py-20 md:py-24 bg-gradient-to-r from-[#8B0000] via-[#700000] to-[#4a0000] text-white text-center overflow-hidden">
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 36px 36px;"></div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <p class="text-[#e07b20] text-sm font-semibold tracking-[0.2em] uppercase mb-3 opacity-90">
        Worship Locations
      </p>
      <h1 class="font-outfit text-4xl sm:text-5xl md:text-6xl font-extrabold text-white mb-4">Our Branches</h1>
      <div class="w-16 h-px bg-white/30 mx-auto mt-4 mb-4"></div>
      <p class="text-white/80 text-base sm:text-lg max-w-xl mx-auto font-light leading-relaxed">
        Find a Bride of Christ Tabernacle location near you and join us for worship and fellowship.
      </p>
    </div>
  </section>

  <!-- Branches Grid -->
  <section class="py-20 md:py-28 bg-[#fafafa] flex-grow">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {branches.map((branch) => (
          <BranchCard 
            branchName={branch.branchName} 
            city={branch.city} 
            address={branch.address} 
            serviceTime={branch.serviceTime} 
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
