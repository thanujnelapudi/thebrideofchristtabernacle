---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Us">
  <!-- Hero Banner -->
  <section
    class="relative py-20 md:py-24 bg-gradient-to-r from-[#8B0000] via-[#700000] to-[#4a0000] text-white text-center overflow-hidden"
  >
    <!-- Subtle background pattern -->
    <div
      class="absolute inset-0 opacity-10 pointer-events-none"
      style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 36px 36px;"
    >
    </div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <p
        class="text-[#e07b20] text-sm font-bold tracking-[0.2em] uppercase mb-3 opacity-90"
      >
        Our Identity & Mission
      </p>
      <h1
        class="font-outfit text-4xl sm:text-5xl md:text-6xl font-extrabold text-white mb-4"
      >
        About Us
      </h1>
      <div class="w-16 h-px bg-white/30 mx-auto mt-4 mb-4"></div>
      <p
        class="text-white/80 text-base sm:text-lg max-w-xl mx-auto font-light leading-relaxed"
      >
        Learn more about our beloved Pastor, our history, and the foundational
        vision that guides Bride of Christ Tabernacle.
      </p>
    </div>
  </section>

  <!-- Pastor Section -->
  <section class="py-20 md:py-28 bg-[#fafafa]">
    <div class="max-w-6xl mx-auto px-6">
      <div
        class="flex flex-col md:flex-row items-center gap-12 lg:gap-16 bg-white rounded-2xl p-8 md:p-12 shadow-sm border border-gray-100"
      >
        <div
          class="w-52 h-52 md:w-64 md:h-64 flex-shrink-0 rounded-full bg-gray-300 overflow-hidden border-4 border-[#8B0000]/20 shadow-xl ring-4 ring-[#8B0000]/10"
        >
          <img
            src="/images/pastor.jpeg"
            alt="Pastor Rufus Daniel"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="text-center md:text-left flex-1">
          <span
            class="text-[#e07b20] font-bold tracking-[0.15em] uppercase text-xs sm:text-sm mb-2 block"
            >Pastor</span
          >
          <h2
            class="font-outfit text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4"
          >
            Pastor Rufus Daniel
          </h2>
          <div
            class="text-gray-600 space-y-4 leading-relaxed font-light text-base md:text-lg"
          >
            <!-- REPLACE: Pastor bio -->
            <p>
              "Welcome to Bride of Christ Tabernacle — a place where every heart
              is welcomed, every burden is shared, and every life is touched by
              the grace of God."
            </p>
            <p>
              He envisions a church where every member is equipped and empowered
              to live out their calling through prayer, fellowship, and sound
              biblical doctrine.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision & Mission -->
  <section class="py-20 md:py-28 bg-white border-y border-gray-100">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <p
          class="text-[#8B0000] font-bold tracking-[0.15em] uppercase text-xs sm:text-sm mb-3"
        >
          Guiding Principles
        </p>
        <h2
          class="font-outfit text-3xl sm:text-4xl font-extrabold text-gray-900"
        >
          Our Vision &amp; Mission
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Vision Card -->
        <div
          class="bg-[#fafafa] p-8 md:p-10 rounded-2xl shadow-sm border-t-4 border-[#8B0000] hover:shadow-md transition-all duration-300"
        >
          <div
            class="w-12 h-12 rounded-xl bg-[#8B0000]/8 flex items-center justify-center mb-6 text-[#8B0000]"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
          </div>
          <h3 class="font-outfit text-2xl font-bold text-gray-900 mb-4">
            Our Vision
          </h3>
          <p class="text-gray-600 leading-relaxed font-light">
            <!-- REPLACE: Vision text -->
            To be a beacon of light in our community, fostering a family of believers
            who are deeply rooted in the Scriptures and actively demonstrating the
            love of Christ to the world.
          </p>
        </div>

        <!-- Mission Card -->
        <div
          class="bg-[#fafafa] p-8 md:p-10 rounded-2xl shadow-sm border-t-4 border-[#e07b20] hover:shadow-md transition-all duration-300"
        >
          <div
            class="w-12 h-12 rounded-xl bg-[#e07b20]/10 flex items-center justify-center mb-6 text-[#e07b20]"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path>
            </svg>
          </div>
          <h3 class="font-outfit text-2xl font-bold text-gray-900 mb-4">
            Our Mission
          </h3>
          <p class="text-gray-600 leading-relaxed font-light">
            <!-- REPLACE: Mission text -->
            To preach the uncompromised Word of God, make disciples of all nations,
            and provide a welcoming sanctuary for worship, fellowship, and spiritual
            growth.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Church History -->
  <section class="py-20 md:py-28 bg-[#fafafa]">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p
        class="text-[#8B0000] font-bold tracking-[0.15em] uppercase text-xs sm:text-sm mb-3"
      >
        Our Legacy
      </p>
      <h3
        class="font-outfit text-3xl sm:text-4xl font-extrabold text-gray-900 mb-8"
      >
        Our History
      </h3>
      <div
        class="bg-white p-8 md:p-12 rounded-2xl shadow-sm border border-gray-100 text-gray-600 leading-relaxed space-y-4 text-left font-light"
      >
        <!-- REPLACE: History text -->
        <p>
          Founded on the enduring principles of faith, the Bride of Christ
          Tabernacle began as a small gathering of devoted believers. Over the
          years, by the grace of God, we have grown into a vibrant congregation.
        </p>
        <p>
          Our journey has been marked by miracles, steadfast prayer, and a
          continuous commitment to serve our local community and beyond.
        </p>
      </div>
    </div>
  </section>
</Layout>
