---
interface ServiceItem {
  name: string;
  schedule: string;
}

interface Props {
  branchName: string;
  churchName?: string;
  fullAddress: string;
  services: ServiceItem[];
  leaderRole: string; // "Pastor" | "Minister"
  leaderName: string;
}

const {
  branchName,
  churchName,
  fullAddress,
  services,
  leaderRole,
  leaderName,
} = Astro.props;
---

<article class="bg-white rounded-2xl shadow-xs border border-gray-100 border-l-4 border-l-[#8B0000] p-6 sm:p-7 hover:shadow-md transition-shadow duration-200">
  
  <!-- Header: Branch Name & Church Title -->
  <div class="pb-4 border-b border-gray-100">
    <h2 class="font-outfit text-xl sm:text-2xl font-bold text-gray-900 leading-tight">
      {branchName}
    </h2>
    {churchName && (
      <p class="text-xs font-semibold text-[#8B0000] mt-0.5 tracking-wide">
        {churchName}
      </p>
    )}
  </div>

  <!-- Content -->
  <div class="space-y-4 pt-4 text-sm">
    
    <!-- Location / Address -->
    <div class="flex items-start gap-2.5 text-gray-600">
      <svg class="w-4 h-4 text-[#8B0000] mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <p class="leading-relaxed text-gray-700">{fullAddress}</p>
    </div>

    <!-- Services List -->
    <div class="pt-1">
      <ul class="space-y-2">
        {services.map((service, index) => (
          <li class={`flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 py-1.5 px-3 rounded-lg ${index === 0 ? 'bg-[#8B0000]/5 text-gray-900 font-medium' : 'text-gray-700'}`}>
            <span class="text-gray-800">{service.name}</span>
            <span class="text-xs font-semibold text-[#8B0000] sm:text-right">{service.schedule}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Pastor / Minister (Compact) -->
    <div class="pt-3 border-t border-gray-100 flex items-center gap-2 text-xs text-gray-600">
      <span class="font-bold text-gray-500 uppercase tracking-wider">{leaderRole}:</span>
      <span class="font-semibold text-gray-900 text-sm">{leaderName}</span>
    </div>

  </div>

</article>
