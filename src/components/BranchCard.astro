---
interface Props {
  branchName: string;
  city: string;
  address: string;
  serviceTime: string;
}

const { branchName, city, address, serviceTime } = Astro.props;
---

<article class="bg-white rounded-2xl shadow-sm border border-gray-100 border-l-4 border-l-[#8B0000] p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group flex flex-col h-full">
  <h3 class="font-outfit text-xl font-bold text-gray-900 pb-4 border-b border-gray-100 mb-5 group-hover:text-[#8B0000] transition-colors duration-200">{branchName}</h3>

  <div class="space-y-4 mt-2 text-sm text-gray-600 flex-grow">
    <div class="flex items-start">
      <svg class="w-5 h-5 text-[#8B0000]/60 mr-3 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <div>
        <span class="font-semibold text-gray-800 block leading-snug">{city}</span>
        <span class="text-gray-500 leading-snug">{address}</span>
      </div>
    </div>

    <div class="flex items-center">
      <svg class="w-5 h-5 text-[#8B0000]/60 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="font-medium text-gray-700">{serviceTime}</span>
    </div>
  </div>
</article>
