---
const year = new Date().getFullYear();

const quickLinks = [
  { name: "Home", href: "/" },
  { name: "About Us", href: "/about" },
  { name: "Our Branches", href: "/branches" },
  { name: "Gallery", href: "/gallery" },
  { name: "Contact", href: "/contact" },
];

const connectIcons = [
  {
    label: "YouTube Channel",
    href: "https://www.youtube.com/channel/UC2uIzBRoPgTt0t73R7N_y6Q",
    isExternal: true,
    type: "fill",
    path: "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.501 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.377.55 9.377.55s7.505 0 9.377-.55a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
  },
  {
    label: "Send Email",
    href: "mailto:danmonu@gmail.com",
    isExternal: false,
    type: "stroke",
    path: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    label: "Call Us",
    href: "tel:9866866856",
    isExternal: false,
    type: "stroke",
    path: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  },
];
---

<footer class="bg-[#0d0d0d] text-white" aria-label="Site footer">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 pt-16 pb-10">
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 lg:gap-16 mb-14"
    >
      <!-- Branding Column -->
      <div
        class="flex flex-col items-center md:items-start text-center md:text-left"
      >
        <a
          href="/"
          class="inline-block mb-4 hover:opacity-80 transition-opacity duration-200"
          aria-label="Go to homepage"
        >
          <img
            src="/images/Logo.jpg"
            alt="Bride of Christ Tabernacle Logo"
            class="h-14 w-14 rounded-full object-cover shadow-md"
          />
        </a>
        <h2 class="font-outfit text-xl font-bold text-white mb-2 leading-snug">
          Bride of Christ<br />Tabernacle
        </h2>
        <p class="text-sm text-gray-500 max-w-[200px] leading-relaxed">
          Uniting Hearts in Faith and Service
        </p>
      </div>

      <!-- Quick Links Column -->
      <div class="flex flex-col items-center md:items-start">
        <h3
          class="font-outfit font-bold text-sm tracking-[0.12em] uppercase text-[#e07b20] mb-6"
        >
          Quick Links
        </h3>
        <ul class="space-y-3 text-center md:text-left">
          {
            quickLinks.map(({ name, href }) => (
              <li>
                <a
                  href={href}
                  class="text-gray-400 hover:text-white transition-colors duration-200 text-[15px] hover:underline underline-offset-2"
                >
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Connect Column -->
      <div class="flex flex-col items-center md:items-start">
        <h3
          class="font-outfit font-bold text-sm tracking-[0.12em] uppercase text-[#e07b20] mb-6"
        >
          Connect With Us
        </h3>

        <!-- Action / Connect icons -->
        <div class="flex items-center gap-3 mb-8">
          {
            connectIcons.map(({ label, href, isExternal, type, path }) => (
              <a
                href={href}
                aria-label={label}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
                class="w-10 h-10 rounded-full bg-white/8 flex items-center justify-center text-gray-400 hover:text-white hover:bg-[#8B0000] transition-all duration-250 focus:outline-none focus:ring-2 focus:ring-[#8B0000]/50"
              >
                {type === "fill" ? (
                  <svg
                    class="w-5 h-5"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d={path} />
                  </svg>
                ) : (
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={path}
                    />
                  </svg>
                )}
              </a>
            ))
          }
        </div>

        <!-- Contact snippet -->
        <div class="space-y-3 text-[15px]">
          <a
            href="tel:9866866856"
            class="flex items-center gap-3 text-gray-400 hover:text-white transition-colors duration-200"
          >
            <svg
              class="w-4 h-4 flex-shrink-0 text-[#e07b20]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            9866 866 856
          </a>
          <a
            href="mailto:danmonu@gmail.com"
            class="flex items-center gap-3 text-gray-400 hover:text-white transition-colors duration-200 break-all"
          >
            <svg
              class="w-4 h-4 flex-shrink-0 text-[#e07b20]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            danmonu@gmail.com
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="border-t border-gray-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="text-sm text-gray-500 text-center sm:text-left">
        &copy; {year} Bride of Christ Tabernacle. All rights reserved.
      </p>
      <p
        class="text-sm text-gray-400 text-center sm:text-right flex items-center justify-center sm:justify-end gap-1.5 flex-wrap"
      >
        <span>Designed &amp; Developed by</span>
        <a
          href="https://thanujportfolio.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#e07b20] hover:text-[#f39c12] font-semibold tracking-wide transition-all duration-200 hover:underline underline-offset-2"
        >
          Thanuj
        </a>
        <span> & </span>
        <a
          href="https://awilliamsolomon.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#e07b20] hover:text-[#f39c12] font-semibold tracking-wide transition-all duration-200 hover:underline underline-offset-2"
        >
          William
        </a>
      </p>
    </div>
  </div>
</footer>
