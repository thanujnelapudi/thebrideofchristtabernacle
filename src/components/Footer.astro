---
const year = new Date().getFullYear();

const quickLinks = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about' },
  { name: 'Our Branches', href: '/branches' },
  { name: 'Gallery', href: '/gallery' },
  { name: 'Contact', href: '/contact' },
];

const socialLinks = [
  {
    label: 'YouTube',
    href: '#',
    icon: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.501 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.377.55 9.377.55s7.505 0 9.377-.55a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
  {
    label: 'Facebook',
    href: '#',
    icon: 'M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z',
  },
  {
    label: 'Instagram',
    href: '#',
    icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.203 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z',
  },
];
---

<footer class="bg-[#0d0d0d] text-white" aria-label="Site footer">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 pt-16 pb-10">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 lg:gap-16 mb-14">

      <!-- Branding Column -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <a href="/" class="inline-block mb-4 hover:opacity-80 transition-opacity duration-200" aria-label="Go to homepage">
          <img src="/images/Logo.jpg" alt="Bride of Christ Tabernacle Logo" class="h-14 w-14 rounded-full object-cover shadow-md" />
        </a>
        <h2 class="font-outfit text-xl font-bold text-white mb-2 leading-snug">
          Bride of Christ<br />Tabernacle
        </h2>
        <p class="text-sm text-gray-500 max-w-[200px] leading-relaxed">
          Uniting Hearts in Faith and Service
        </p>
      </div>

      <!-- Quick Links Column -->
      <div class="flex flex-col items-center md:items-start">
        <h3 class="font-outfit font-bold text-sm tracking-[0.12em] uppercase text-[#e07b20] mb-6">Quick Links</h3>
        <ul class="space-y-3 text-center md:text-left">
          {quickLinks.map(({ name, href }) => (
            <li>
              <a
                href={href}
                class="text-gray-400 hover:text-white transition-colors duration-200 text-[15px] hover:underline underline-offset-2"
              >
                {name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect Column -->
      <div class="flex flex-col items-center md:items-start">
        <h3 class="font-outfit font-bold text-sm tracking-[0.12em] uppercase text-[#e07b20] mb-6">Connect With Us</h3>

        <!-- Social icons -->
        <div class="flex items-center gap-3 mb-8">
          {socialLinks.map(({ label, href, icon }) => (
            <a
              href={href}
              aria-label={label}
              class="w-10 h-10 rounded-full bg-white/8 flex items-center justify-center text-gray-400 hover:text-white hover:bg-[#8B0000] transition-all duration-250 focus:outline-none focus:ring-2 focus:ring-[#8B0000]/50"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={icon} />
              </svg>
            </a>
          ))}
        </div>

        <!-- Contact snippet -->
        <div class="space-y-3 text-[15px]">
          <a href="tel:+15551234567" class="flex items-center gap-3 text-gray-400 hover:text-white transition-colors duration-200">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <!-- REPLACE: Phone number -->
            +1 (555) 123-4567
          </a>
          <a href="mailto:info@brideofchristtabernacle.com" class="flex items-center gap-3 text-gray-400 hover:text-white transition-colors duration-200 break-all">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <!-- REPLACE: Email address -->
            info@brideofchristtabernacle.com
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-gray-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-gray-600 text-center sm:text-left">
        &copy; {year} Bride of Christ Tabernacle. All rights reserved.
      </p>
      <p class="text-sm text-gray-700 text-center sm:text-right">
        Built with faith &amp; purpose.
      </p>
    </div>

  </div>
</footer>
